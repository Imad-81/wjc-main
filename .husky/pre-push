#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Bypass hooks if explicitly allowed via env var or CI user
if [ "$HUSKY_SKIP" = "1" ]; then
  exit 0
fi

user_email=$(git config user.email)
if [ "$user_email" = "ci@your-org.com" ]; then
  exit 0
fi

# Prevent pushing directly to protected branches
branch="$(git rev-parse --abbrev-ref HEAD)"
protected_branches="main master stable"

for b in $protected_branches; do
  if [ "$branch" = "$b" ]; then
    echo ""
    echo "Push blocked: pushing directly to '$branch' is not allowed."
    echo "Create a feature branch and open a pull request instead."
    echo ""
    exit 1
  fi
done

exit 0
exit 0
